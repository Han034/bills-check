# Copy to .env and fill in. Each provider is optional; at least one is required (or DEMO=1).

# ---- panel ----
HOST=127.0.0.1
PORT=8787
# Required when HOST is not loopback (e.g. in Docker). Any user name, this password.
DASHBOARD_PASSWORD=
# DATA_DIR=./data

# ---- rules ----
# Applied to keys the watcher sees for the first time; change per key in the panel.
# warn | kill
DEFAULT_MODE=warn
# USD allowed in the rolling window
DEFAULT_WINDOW_USD=5
# USD allowed since local midnight (server TZ)
DEFAULT_DAILY_USD=50
WINDOW_MIN=15
POLL_INTERVAL_SEC=60
# How long a runaway would run before the provider's own budget alert: only feeds the "saved" estimate.
ALERT_DELAY_MIN=360
# Start here: rules fire and notify, but no key is ever disabled.
DRY_RUN=1

# ---- OpenAI (organization Admin key, sk-admin-...) ----
# Note: OpenAI cannot switch a key off and on; "kill" DELETES the key.
OPENAI_ADMIN_KEY=

# ---- Anthropic (Admin API key, sk-ant-admin...) ----
ANTHROPIC_ADMIN_KEY=

# ---- Gemini (Google Cloud project that owns the API keys) ----
# Auth: a service account with roles/monitoring.viewer and roles/serviceusage.apiKeysAdmin.
GEMINI_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp.json
# Google reports requests, not tokens, per key: spend = requests x this.
GEMINI_COST_PER_REQUEST=0.002

# ---- notifications (any of them) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ---- extra ----
# JSON with {"openai": {"model-prefix": {input, output, cacheRead?, cacheWrite?, cacheWriteLong?}}, "anthropic": {...}} (USD per 1M tokens)
# PRICES_FILE=./prices.json
# fake keys, no accounts; for trying the panel
# DEMO=1
