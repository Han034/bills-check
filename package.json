{
  "name": "fatura-bekcisi",
  "version": "0.1.0",
  "description": "LLM API anahtarlarını dakikada bir izleyen, eşik aşılınca uyaran ya da anahtarı kapatan kendi sunucunda çalışan bekçi.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Han034/fatura-bekcisi.git"
  },
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "api-keys",
    "cost",
    "billing",
    "circuit-breaker",
    "self-hosted"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "google-auth-library": "^9.15.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
